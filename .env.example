# Gmail creds (recommended: use an app password)
GMAIL_USER=your-email@gmail.com
GMAIL_PASSWORD=your-app-password

# Server
PORT=3000

# Defaults used by body builders
ADMIN_EMAIL=your@gmail.com
APP_NAME=My App
CTA_URL=https://example.com
SUPPORT_EMAIL=support@example.com

# Firebase project metadata
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_STORAGE_BUCKET=your-firebase-project-id.firebasestorage.app

# Server-side Firebase credentials (provide one of these):
# 1) JSON string copied from a Firebase service account key:
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}
#
# 2) Base64-encoded service account JSON:
# FIREBASE_SERVICE_ACCOUNT_BASE64=base64-encoded-json
#
# 3) Path to a local service account file:
# FIREBASE_SERVICE_ACCOUNT_PATH=/absolute/path/to/serviceAccountKey.json
#
# 4) Google-style credentials path (works the same as above in this app):
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/serviceAccountKey.json
